{
  "name": "proxy-reviewer",
  "version": "0.1.0",
  "private": true,
  "description": "Local daemon that finds PRs requesting your review and has Claude review them",
  "type": "module",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "once": "node src/index.ts --once",
    "review": "node src/index.ts --review",
    "typecheck": "tsc",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.281",
    "octokit": "5.0.5",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "24.13.6",
    "pino-pretty": "13.1.3",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
