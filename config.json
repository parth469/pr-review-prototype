{
  "pollIntervalSec": 60,
  "repos": {
    "allow": ["Axy-Science/Axy-K-Git"],
    "deny": []
  },
  "skipDrafts": false,
  "skipOwnPrs": true,
  "skipBranches": ["staging", "dev", "cycle-*"],
  "maxChangedLines": 10000,
  "dataDir": "data",
  "logLevel": "info",
  "cacheDir": "cache",
  "workDir": "work",
  "reviewsDir": "reviews",
  "logDir": "logs",
  "gitTimeoutSec": 300,
  "review": {
    "enabled": true,
    "model": "claude-opus-5-5",
    "effort": "high",
    "maxSessionUsagePct": 90,
    "style": "readable",
    "pluginPath": null,
    "timeoutMin": 20,
    "maxTurns": 80,
    "maxAttempts": 3,
    "keepWorktree": false
  },
  "publish": {
    "mode": "submit",
    "requireStillRequested": true
  },
  "statusPage": {
    "enabled": true,
    "port": 4777
  },
  "notify": {
    "enabled": true,
    "onPosted": true,
    "onFailed": true
  }
}
